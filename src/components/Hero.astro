---
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

export interface Props {
  video?: string;
  videoWebm?: string;
  videoBytes?: number;
  posterImage: ImageMetadata;
  posterAlt: string;
  /** image alternative affichée uniquement sur mobile (<768px), au-dessus du poster vidéo */
  mobilePosterImage?: ImageMetadata;
  mobilePosterAlt?: string;
  eyebrow?: string;
  title: string;
  /** sous-titre H2 SEO, rendu juste sous le h1 */
  heading2?: string;
  tagline?: string;
  subtitle?: string;
}

const {
  video,
  videoWebm,
  videoBytes = 0,
  posterImage,
  posterAlt,
  mobilePosterImage,
  mobilePosterAlt,
  eyebrow,
  title,
  heading2,
  tagline,
  subtitle,
} = Astro.props;

const heavy = videoBytes > 5 * 1024 * 1024;

const posterOptimized = await getImage({
  src: posterImage,
  width: 1920,
  format: 'jpg',
  quality: 75,
});
---

<section class="relative w-full min-h-[560px] h-[78vh] md:h-[82vh] overflow-hidden bg-[var(--color-bg-deep)]">
  {
    video ? (
      <video
        id="hero-video"
        class="absolute inset-0 w-full h-full object-cover"
        poster={posterOptimized.src}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
        data-src={video}
        data-src-webm={videoWebm}
        data-heavy={heavy ? 'true' : 'false'}
      />
    ) : (
      <Picture
        src={posterImage}
        alt={posterAlt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover"
      />
    )
  }

  {
    /* override mobile-only : image alternative au-dessus du poster vidéo (<768px) */
    mobilePosterImage && (
      <Picture
        src={mobilePosterImage}
        alt={mobilePosterAlt ?? posterAlt}
        formats={['avif', 'webp']}
        widths={[480, 640, 768]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="md:hidden absolute inset-0 w-full h-full object-cover z-[1]"
      />
    )
  }

  <div
    class="absolute inset-0 bg-gradient-to-b from-black/15 via-black/20 to-black/55"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative h-full mx-auto max-w-6xl px-5 md:px-8 flex flex-col justify-end pb-14 md:pb-24 text-[var(--color-bg)]"
  >
    {eyebrow && (
      <p
        class="lc font-medium text-sm md:text-[0.9375rem] text-[var(--color-bg)]/85 mb-3 md:mb-5 tracking-wide"
        data-intro-stagger="0"
      >
        {eyebrow}
      </p>
    )}
    <h1 class="lc hero-title max-w-4xl" data-intro-stagger="1">{title}</h1>
    {heading2 && (
      <h2
        class="lc mt-3 md:mt-4 max-w-3xl text-base md:text-lg font-medium text-[var(--color-bg)]/90"
        data-intro-stagger="2"
      >
        {heading2}
      </h2>
    )}
    {tagline && (
      <p
        class="mt-4 md:mt-5 text-lg md:text-xl font-medium text-[var(--color-bg)]"
        data-intro-stagger="2"
      >
        {tagline}
      </p>
    )}
    {subtitle && (
      <p
        class="lc lead mt-5 md:mt-7 max-w-2xl text-[var(--color-bg)]/90 font-medium"
        data-intro-stagger={tagline ? '3' : '2'}
      >
        {subtitle}
      </p>
    )}
  </div>
</section>

{
  video && (
    <script is:inline>
      (function () {
        var v = document.getElementById('hero-video');
        if (!v) return;
        var src = v.getAttribute('data-src');
        var srcWebm = v.getAttribute('data-src-webm');
        if (!src) return;

        var isMobile = window.matchMedia('(max-width: 639px)').matches;
        var conn =
          navigator.connection || navigator.webkitConnection || navigator.mozConnection;
        var slow = false;
        if (conn) {
          if (conn.saveData) slow = true;
          var et = conn.effectiveType;
          if (et === 'slow-2g' || et === '2g') slow = true;
        }
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // poster reste seul si : mobile (<640px), connexion lente (2g/slow-2g),
        // save-data activé, ou utilisateur préfère reduced motion
        if (isMobile || slow || reduceMotion) return;

        if (srcWebm) {
          var sourceWebm = document.createElement('source');
          sourceWebm.src = srcWebm;
          sourceWebm.type = 'video/webm';
          v.appendChild(sourceWebm);
        }
        var source = document.createElement('source');
        source.src = src;
        source.type = 'video/mp4';
        v.appendChild(source);
        v.load();
        var p = v.play();
        if (p && typeof p.catch === 'function') {
          p.catch(function () {
            /* autoplay bloqué, le poster reste visible */
          });
        }
      })();
    </script>
  )
}
