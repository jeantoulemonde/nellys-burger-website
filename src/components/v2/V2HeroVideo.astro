---
/*
  V2HeroVideo — vidéo hero v2 avec teinte ambrée légère.
  Reprend la mécanique de lazy-load de Hero.astro (v1) : poster seul sur
  mobile, slow-2g, save-data ou reduce-motion ; sources injectées en JS
  uniquement sinon. La teinte est volontairement très légère (gradient
  noir bas + overlay ambré 8%) pour préserver la lisibilité de la vidéo.
*/
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

export interface Props {
  video: string;
  videoBytes?: number;
  posterImage: ImageMetadata;
  posterAlt: string;
}

const { video, videoBytes = 0, posterImage, posterAlt } = Astro.props;

const heavy = videoBytes > 5 * 1024 * 1024;

const posterOptimized = await getImage({
  src: posterImage,
  width: 1920,
  format: 'jpg',
  quality: 75,
});
---

<div class="v2-hero-video" aria-hidden="true">
  <video
    id="v2-hero-video"
    class="v2-hero-video__el"
    poster={posterOptimized.src}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    aria-label={posterAlt}
    data-src={video}
    data-heavy={heavy ? 'true' : 'false'}></video>

  <div class="v2-hero-video__tint"></div>
</div>

<script is:inline>
  (function () {
    var v = document.getElementById('v2-hero-video');
    if (!v) return;
    var src = v.getAttribute('data-src');
    if (!src) return;

    var isMobile = window.matchMedia('(max-width: 639px)').matches;
    var conn =
      navigator.connection || navigator.webkitConnection || navigator.mozConnection;
    var slow = false;
    if (conn) {
      if (conn.saveData) slow = true;
      var et = conn.effectiveType;
      if (et === 'slow-2g' || et === '2g') slow = true;
    }
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // poster reste seul si : mobile (<640px), connexion lente, save-data ou reduce-motion
    if (isMobile || slow || reduceMotion) return;

    var source = document.createElement('source');
    source.src = src;
    source.type = 'video/mp4';
    v.appendChild(source);
    v.load();
    var p = v.play();
    if (p && typeof p.catch === 'function') {
      p.catch(function () {
        /* autoplay bloqué, le poster reste visible */
      });
    }
  })();
</script>

<style>
  .v2-hero-video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: var(--v2-bg-deep);
  }

  .v2-hero-video__el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* désaturation très légère pour caler la vidéo dans l'ambiance sombre,
       sans dénaturer l'image. pas de pixelisation. */
    filter: saturate(0.9) contrast(1.02);
  }

  /* teinte ambrée + gradient noir en bas pour lisibilité du titre */
  .v2-hero-video__tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(10, 10, 10, 0.35) 0%,
        rgba(10, 10, 10, 0.55) 65%,
        rgba(10, 10, 10, 0.85) 100%
      ),
      linear-gradient(135deg,
        rgba(240, 168, 48, 0.06),
        rgba(255, 217, 103, 0.04));
  }
</style>
