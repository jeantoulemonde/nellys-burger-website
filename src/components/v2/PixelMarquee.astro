---
/*
  PixelMarquee — bannière défilante signature (full-width).
  Réutilisable : pose-la en haut ou en bas de page.
  Accessibilité :
    — aria-label sur la bannière, lu par les SR
    — texte décoratif dupliqué marqué aria-hidden
    — prefers-reduced-motion désactive l'animation
*/
export interface Props {
  /** texte unique répété OU tableau de phrases qui alternent. les séparateurs
      sont injectés entre chaque phrase, ne pas les inclure dans le texte. */
  text: string | string[];
  /** caractère décoratif entre chaque répétition */
  separator?: string;
  /** durée du défilement en secondes (24 par défaut) */
  duration?: number;
  /** couleur dominante : 'yellow' (défaut, jaune Nelly's) ou 'cream' */
  color?: 'yellow' | 'cream';
  /** position : 'top' (bordure bas uniquement) ou 'standalone' (bordures haut + bas) */
  position?: 'top' | 'standalone';
}

const {
  text,
  separator = '◆',
  duration = 28,
  color = 'yellow',
  position = 'standalone',
} = Astro.props;

const phrases = Array.isArray(text) ? text : [text];
const ariaLabel = phrases.join(` ${separator} `);
/* boucle de 6 cycles complets pour que la moitié duplicate (en JSX en bas)
   garantisse un loop sans saut visible quel que soit le nombre de phrases */
const repeats = 6;
const groups = Array.from({ length: repeats * phrases.length }, (_, i) => ({
  text: phrases[i % phrases.length],
  i,
}));
const sep = separator;
---

<div
  class:list={[
    'v2-marquee',
    `v2-marquee--${color}`,
    `v2-marquee--${position}`,
  ]}
  aria-label={ariaLabel}
  style={`--v2-marquee-dur: ${duration}s;`}
>
  <div class="v2-marquee__track" aria-hidden="true">
    {
      groups.map((g) => (
        <span class="v2-marquee__group">
          <span class="v2-marquee__text">{g.text}</span>
          <span class="v2-marquee__sep">{sep}</span>
        </span>
      ))
    }
    {
      groups.map((g) => (
        <span class="v2-marquee__group">
          <span class="v2-marquee__text">{g.text}</span>
          <span class="v2-marquee__sep">{sep}</span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .v2-marquee {
    position: relative;
    width: 100%;
    background-color: var(--v2-bg-deep);
    overflow: hidden;
    height: 48px;
    display: flex;
    align-items: center;
    border-top: 2px solid var(--v2-yellow-deep);
    border-bottom: 2px solid var(--v2-yellow-deep);
  }

  @media (min-width: 768px) {
    .v2-marquee {
      height: 56px;
    }
  }

  .v2-marquee--top {
    border-top: none;
  }

  .v2-marquee--cream {
    border-color: var(--v2-cream);
  }

  .v2-marquee--yellow {
    border-color: var(--v2-yellow);
  }

  .v2-marquee__track {
    display: flex;
    width: max-content;
    animation: v2-marquee-slide var(--v2-marquee-dur, 28s) linear infinite;
    will-change: transform;
  }

  .v2-marquee:hover .v2-marquee__track {
    animation-play-state: paused;
  }

  .v2-marquee__group {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    white-space: nowrap;
  }

  .v2-marquee__text {
    font-family: var(--v2-font-pixel);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: lowercase;
  }

  @media (min-width: 768px) {
    .v2-marquee__text {
      font-size: 1.75rem;
    }
  }

  .v2-marquee__sep {
    font-size: 1rem;
    line-height: 1;
  }

  .v2-marquee--yellow .v2-marquee__text,
  .v2-marquee--yellow .v2-marquee__sep {
    color: var(--v2-yellow);
    text-shadow:
      0 0 4px rgba(255, 217, 103, 0.95),
      0 0 12px rgba(240, 168, 48, 0.65),
      0 0 24px rgba(200, 122, 24, 0.4);
  }

  .v2-marquee--cream .v2-marquee__text,
  .v2-marquee--cream .v2-marquee__sep {
    color: var(--v2-cream);
    text-shadow:
      0 0 4px rgba(255, 244, 194, 0.85),
      0 0 12px rgba(255, 217, 103, 0.45),
      0 0 24px rgba(240, 168, 48, 0.25);
  }

  @keyframes v2-marquee-slide {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-marquee__track {
      animation-duration: 120s;
    }
  }
</style>
