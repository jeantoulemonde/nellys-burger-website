---
import { site } from '~/data/site';

/*
  V2Header — pixel synthwave header, logo signature manuscrit "nelly's"
  (le même que la v1) traité en néon jaune via CSS filter pour faire
  contraste avec la typo pixel du reste de la page. C'est cette tension
  signature manuscrite / pixel qui donne du caractère.
  La technique filter est reprise de IntroOverlay (état final stabilisé).
*/

const links = [
  { href: '/menu', label: 'menu' },
  { href: '/contact', label: 'contact' },
  { href: '/', label: 'v1' },
];
---

<header class="v2-header">
  <div class="v2-header__inner">
    <a
      href="/v2"
      class="v2-header__brand"
      aria-label={`Aller à l'accueil v2, ${site.name}`}
    >
      <picture class="v2-header__logo">
        <source srcset="/media/logo.avif" type="image/avif" />
        <img
          src="/media/logo.png"
          alt={site.name}
          width="480"
          height="184"
          decoding="async"
        />
      </picture>
    </a>

    <nav aria-label="Navigation principale">
      <ul class="v2-header__nav">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="v2-header__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .v2-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgb(10 10 10 / 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 2px solid var(--v2-yellow);
    box-shadow: 0 0 16px rgba(255, 217, 103, 0.25);
  }

  .v2-header__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 4.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .v2-header__inner {
      padding: 0 1.5rem;
      height: 5rem;
    }
  }

  .v2-header__brand {
    display: inline-flex;
    align-items: center;
    color: var(--v2-yellow);
    text-decoration: none;
    line-height: 0;
  }

  .v2-header__logo {
    display: inline-block;
    line-height: 0;
  }

  /* convertit le logo png noir-sur-transparent en signature jaune néon
     avec glow multi-couches. même technique que IntroOverlay (état final),
     mais glow plus discret pour ne pas surcharger le header. */
  .v2-header__logo img {
    display: block;
    width: auto;
    /* taille modérée sur mobile, plus généreuse sur desktop */
    height: 2.5rem;
    filter:
      invert(1) sepia(1) saturate(8) hue-rotate(-12deg) brightness(1.25)
      drop-shadow(0 0 3px rgba(255, 244, 194, 0.7))
      drop-shadow(0 0 8px rgba(255, 217, 103, 0.55))
      drop-shadow(0 0 18px rgba(240, 168, 48, 0.35));
  }

  @media (min-width: 768px) {
    .v2-header__logo img {
      height: 3.25rem;
    }
  }

  .v2-header__nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .v2-header__nav {
      gap: 2rem;
    }
  }

  .v2-header__link {
    font-family: var(--v2-font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--v2-cream-soft);
    text-decoration: none;
    text-transform: lowercase;
    letter-spacing: 0.02em;
    transition: color 180ms ease, text-shadow 180ms ease;
  }

  .v2-header__link:hover {
    color: var(--v2-yellow);
    text-shadow:
      0 0 4px rgba(255, 217, 103, 0.9),
      0 0 12px rgba(240, 168, 48, 0.55);
  }
</style>
