---
import { site } from '~/data/site';

/*
  V2Header — pixel synthwave header, logo signature manuscrit "nelly's"
  (le même que la v1). Colorisé en jaune via mask-image (pas de filter
  chain invert/sepia : couleur plate propre), glow néon via drop-shadow.
  C'est la tension signature manuscrite / typo pixel qui donne le caractère.
*/

const links = [
  { href: '/menu', label: 'menu' },
  { href: '/contact', label: 'contact' },
  { href: '/', label: 'v1' },
];
---

<header class="v2-header">
  <div class="v2-header__inner">
    <a
      href="/v2"
      class="v2-header__brand"
      aria-label={`Aller à l'accueil v2, ${site.name}`}
    >
      <span class="v2-header__logo" role="img" aria-label={site.name}></span>
    </a>

    <nav aria-label="Navigation principale">
      <ul class="v2-header__nav">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="v2-header__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .v2-header {
    position: sticky;
    top: 0;
    /* z-index 101 pour passer au-dessus des scanlines (body::before, z=100)
       et de la vignette CRT (body::after, z=99). Sans ça, multiply-blend-mode
       des scanlines tirait des traits horizontaux à travers le logo. */
    z-index: 101;
    background-color: rgb(10 10 10 / 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 2px solid var(--v2-yellow);
    box-shadow: 0 0 16px rgba(255, 217, 103, 0.25);
  }

  .v2-header__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .v2-header__inner {
      padding: 0 1.5rem;
      height: 6rem;
    }
  }

  .v2-header__brand {
    display: inline-flex;
    align-items: center;
    color: var(--v2-yellow);
    text-decoration: none;
    line-height: 0;
  }

  .v2-header__logo {
    display: inline-block;
    line-height: 0;
  }

  /* logo en jaune plat via mask-image (couleur unie, sans filter de
     conversion) + drop-shadow pour le glow néon. ratio ~480/184 = 2.61 */
  .v2-header__logo {
    display: block;
    width: 8.5rem;
    height: 3.25rem;
    background-color: var(--v2-yellow);
    -webkit-mask-image: url('/media/logo.png');
    mask-image: url('/media/logo.png');
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: left center;
    mask-position: left center;
    filter:
      drop-shadow(0 0 3px rgba(255, 244, 194, 0.7))
      drop-shadow(0 0 9px rgba(255, 217, 103, 0.5))
      drop-shadow(0 0 20px rgba(240, 168, 48, 0.35));
  }

  @media (min-width: 768px) {
    .v2-header__logo {
      width: 11rem;
      height: 4.25rem;
    }
  }

  .v2-header__nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .v2-header__nav {
      gap: 2rem;
    }
  }

  .v2-header__link {
    font-family: var(--v2-font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--v2-cream-soft);
    text-decoration: none;
    text-transform: lowercase;
    letter-spacing: 0.02em;
    transition: color 180ms ease, text-shadow 180ms ease;
  }

  .v2-header__link:hover {
    color: var(--v2-yellow);
    text-shadow:
      0 0 4px rgba(255, 217, 103, 0.9),
      0 0 12px rgba(240, 168, 48, 0.55);
  }
</style>
