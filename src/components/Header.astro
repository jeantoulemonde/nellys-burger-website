---
import { site } from '~/data/site';

export interface Props {
  locale?: 'fr' | 'en';
}

const { locale = 'fr' } = Astro.props;

const linksByLocale = {
  fr: [
    { href: '/', label: 'accueil' },
    { href: '/menu', label: 'menu' },
    { href: '/contact', label: 'contact' },
  ],
  en: [
    { href: '/en', label: 'home' },
    { href: '/en/menu', label: 'menu' },
    { href: '/en/contact', label: 'contact' },
  ],
} as const;

const links = linksByLocale[locale];
const homeHref = locale === 'en' ? '/en' : '/';
const ariaHome = locale === 'en' ? `Go to home, ${site.name}` : `Aller à l'accueil, ${site.name}`;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  class="sticky top-0 z-40 bg-[var(--color-bg)]/85 backdrop-blur border-b border-[var(--color-line)]"
>
  <div class="mx-auto max-w-6xl px-5 md:px-8 h-16 md:h-18 flex items-center justify-between">
    <a
      href={homeHref}
      class="flex items-center"
      aria-label={ariaHome}
    >
      <picture>
        <source srcset="/media/logo.avif" type="image/avif" />
        <img
          src="/media/logo.png"
          alt={site.name}
          width="480"
          height="184"
          class="h-7 md:h-9 w-auto"
          decoding="async"
        />
      </picture>
    </a>

    <nav aria-label={locale === 'en' ? 'Main navigation' : 'Navigation principale'}>
      <ul class="flex items-center gap-5 md:gap-8 text-sm">
        {
          links.map((link) => {
            const isActive =
              link.href === homeHref
                ? pathname === link.href || (link.href === '/' && pathname === '/')
                : pathname === link.href || pathname.startsWith(link.href + '/');
            return (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'lc transition-colors duration-200',
                    isActive
                      ? 'font-bold text-[var(--color-ink)]'
                      : 'font-medium text-[var(--color-ink-muted)] hover:text-[var(--color-accent)]',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
