---
import { site } from '~/data/site';

const links = [
  { href: '/', label: 'accueil' },
  { href: '/menu', label: 'menu' },
  { href: '/le-concept', label: 'le concept' },
  { href: '/contact', label: 'contact' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  class="sticky top-0 z-40 bg-[var(--color-bg)]/90 backdrop-blur border-b border-[var(--color-line)]"
>
  <div class="mx-auto max-w-6xl px-5 md:px-8 h-14 flex items-center justify-between">
    <a
      href="/"
      class="lc font-bold text-lg tracking-tight"
      aria-label={`Aller à l'accueil — ${site.name}`}
    >
      {site.name.toLowerCase()}
    </a>

    <nav aria-label="Navigation principale">
      <ul class="flex items-center gap-5 md:gap-8 text-sm">
        {
          links.map((link) => {
            const isActive =
              link.href === '/'
                ? pathname === '/'
                : pathname === link.href || pathname.startsWith(link.href + '/');
            return (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'lc transition-colors',
                    isActive
                      ? 'font-bold text-[var(--color-ink)]'
                      : 'font-normal text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
