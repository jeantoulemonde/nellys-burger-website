---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import storefront from '~/assets/photos/storefront.jpg';
import neon from '~/assets/photos/neon.png';
import stickers from '~/assets/photos/stickers.jpg';

type Card = {
  image: ImageMetadata;
  alt: string;
};

const cards: Card[] = [
  { image: storefront, alt: "vitrine du smash burger Nelly's à Biarritz, store jaune avenue du jardin public" },
  { image: neon, alt: "enseigne néon jaune Nelly's, smash burger Biarritz" },
  { image: stickers, alt: "stickers Nelly's burger Biarritz" },
];

// duplique les 3 cards (6 au total) pour la boucle marquee sans saut
const loop = [...cards, ...cards];
---

<section class="mobile-hero md:hidden" aria-label="hero">
  <div class="mobile-hero-text">
    <h1 class="lc hero-title">come and get your fingers salty.</h1>
    <h2 class="lc mobile-hero-h2">smash burger à emporter à Biarritz, depuis 2022.</h2>
    <p class="lc lead mobile-hero-subtitle">ouvert 7j/7, midi et soir.</p>
  </div>

  <p class="lc meta mobile-hero-marker">now serving</p>

  <div class="marquee-wrapper">
    <div class="marquee-track">
      {
        loop.map((card, i) => (
          <article class="marquee-card" aria-hidden={i >= cards.length ? 'true' : 'false'}>
            <Picture
              src={card.image}
              alt={i >= cards.length ? '' : card.alt}
              formats={['avif', 'webp']}
              widths={[280, 400, 600]}
              sizes="200px"
              loading="eager"
              class="marquee-card-img"
            />
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mobile-hero {
    padding: 1.5rem 0 2rem;
    background-color: var(--color-bg);
  }

  .mobile-hero-text {
    padding: 0 1.25rem 1.5rem;
  }

  .mobile-hero-h2 {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text-soft);
    max-width: 32ch;
  }

  .mobile-hero-subtitle {
    margin-top: 0.625rem;
  }

  .mobile-hero-marker {
    margin: 0 1.25rem 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .marquee-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .marquee-track {
    display: flex;
    gap: 10px;
    width: max-content;
    animation: mobile-marquee 20s linear infinite;
    will-change: transform;
  }

  @keyframes mobile-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .marquee-card {
    position: relative;
    width: 200px;
    height: 260px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--color-bg-deep, #1a1410);
  }

  .marquee-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      padding: 0 1.25rem;
    }
    .marquee-wrapper {
      overflow: visible;
    }
    .marquee-card {
      width: 100%;
      height: auto;
      aspect-ratio: 200 / 260;
    }
    .marquee-card:nth-child(n + 4) {
      display: none;
    }
  }
</style>
