---
import { Picture } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import { restaurantSchema, breadcrumbSchema } from '~/data/schema';

import storefront from '~/assets/photos/storefront.jpg';
import counterPlancha from '~/assets/photos/counter-plancha.jpg';

const jsonLd = [
  restaurantSchema,
  breadcrumbSchema([
    { name: 'Accueil', path: '/v1/' },
    { name: 'Burger à emporter Biarritz', path: '/v1/burger-a-emporter-biarritz' },
  ]),
];
---

<Layout
  title="Burger à emporter Biarritz — Nelly's, 7j/7"
  description="Burger à emporter à Biarritz, sans réservation, sans appli, sans téléphone. Comptoir, sac kraft, jardin public en face. Ouvert 7j/7 de 12h à 22h."
  path="/v1/burger-a-emporter-biarritz"
  image="/og-image.jpg"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-5 md:px-8 pt-12 md:pt-20 pb-20">
    <p class="lc meta mb-3">à emporter</p>
    <h1 class="lc page-title mb-6">burger à emporter à Biarritz.</h1>

    <Picture
      src={storefront}
      alt="vitrine Nelly's burger à emporter Biarritz, store jaune avenue du jardin public"
      formats={['avif', 'webp']}
      widths={[480, 768, 1024]}
      sizes="(min-width: 768px) 720px, 100vw"
      loading="eager"
      class="w-full aspect-[4/5] object-cover rounded-[var(--radius-lg)] mb-10"
    />

    <div class="prose-body lc space-y-5 text-[var(--color-ink)]">
      <p class="lead">
        Pas de salle. Pas d'appli. Pas de réservation. Pas de téléphone.
        Comptoir, sac kraft, et le jardin public juste en face pour s'asseoir.
      </p>

      <p>
        Nelly's est un burger à emporter à Biarritz. On commande au comptoir,
        on attend cinq à dix minutes, on repart avec un sac. C'est tout. Les
        smash burgers ne supportent pas la livraison : trente minutes dans une
        boîte et la croûte ramollit, le pain se gorge de jus. Donc pas de
        plateforme, pas de coursier. Le burger est fait pour être mangé chaud.
      </p>

      <h2 class="lc section-title mt-10 mb-3">comment ça marche</h2>
      <p>
        On arrive au comptoir, on commande, on règle. CB ou espèces. La
        carte tient sur une page : trois burgers, deux sides, six boissons.
        Pendant qu'on prépare, on patiente debout ou sur les bancs du
        jardin public, à trente secondes. Le sac sort, on l'embarque, on
        mange où on veut. Plage des Basques à vingt minutes à pied, Grande
        Plage à dix.
      </p>

      <h2 class="lc section-title mt-10 mb-3">horaires</h2>
      <p>
        Ouvert 7 jours sur 7, de 12h à 22h. Service continu, pas de coupure.
        Cuisine fermée à 22h, dernier ordre vers 21h45. Du midi au soir,
        sans interruption.
      </p>

      <h2 class="lc section-title mt-10 mb-3">l'adresse</h2>
      <p>
        21 avenue du jardin public, 64200 Biarritz. Repère : le store jaune
        et l'enseigne néon. Parkings publics à cinq minutes à pied (Sainte-Eugénie,
        Halles). En haute saison, mieux vaut venir à pied, à vélo ou en bus.
      </p>

      <Picture
        src={counterPlancha}
        alt="comptoir et plancha Nelly's, burger à emporter Biarritz, cuisine ouverte"
        formats={['avif', 'webp']}
        widths={[480, 768, 1024]}
        sizes="(min-width: 768px) 720px, 100vw"
        loading="lazy"
        class="w-full aspect-[4/5] object-cover rounded-[var(--radius-lg)] mt-10"
      />
    </div>

    <nav class="mt-12 pt-8 border-t border-[var(--color-line)] lc meta flex flex-col gap-2" aria-label="pages liées">
      <a href="/v1/smash-burger-biarritz" class="hover:text-[var(--color-ink)]">→ le smash burger à Biarritz expliqué</a>
      <a href="/v1/menu" class="hover:text-[var(--color-ink)]">→ voir le menu et les prix</a>
      <a href="/v1/biarritz/jardin-public" class="hover:text-[var(--color-ink)]">→ Nelly's au jardin public, Biarritz</a>
      <a href="/v1/contact" class="hover:text-[var(--color-ink)]">→ contact et plan d'accès</a>
    </nav>
  </article>
</Layout>
