---
import { Picture } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import { site } from '~/data/site';

import kitchenWide from '~/assets/photos/kitchen-wide.jpg';
import counterPlancha from '~/assets/photos/counter-plancha.jpg';
import ceilingNeons from '~/assets/photos/ceiling-neons.jpg';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `le concept de ${site.name}`,
  description:
    "smash burger à emporter à biarritz : la méthode, les produits, le format. tout ce qu'il faut savoir avant de venir.",
  url: `${site.url}/le-concept`,
  mainEntity: {
    '@type': 'Restaurant',
    name: site.name,
    url: site.url,
  },
};
---

<Layout
  title="le concept, smash burger à emporter à biarritz"
  description="la méthode smash burger, les produits, le format. nelly's burger, biarritz."
  path="/le-concept"
  type="article"
  jsonLd={articleSchema}
>
  <section class="mx-auto max-w-6xl px-5 md:px-8 pt-16 md:pt-24 pb-12">
    <p class="lc meta mb-4">le concept</p>
    <h1 class="lc page-title max-w-3xl">
      une boule de boeuf, écrasée sur la plancha.
    </h1>
  </section>

  <section class="mx-auto max-w-6xl px-5 md:px-8 grid md:grid-cols-12 gap-10 md:gap-16 pb-20 md:pb-28">
    <div class="md:col-span-7">
      <Picture
        src={kitchenWide}
        alt="cuisine ouverte nelly's burger biarritz : plancha en service, hotte inox, néons industriels"
        formats={['avif', 'webp']}
        widths={[480, 768, 1024, 1400]}
        sizes="(min-width: 768px) 58vw, 100vw"
        loading="eager"
        class="w-full aspect-[4/3] object-cover rounded-[var(--radius-lg)]"
      />
    </div>
    <div class="md:col-span-5 prose-body lc space-y-5">
      <p class="lead">
        une boule de viande fraîche, écrasée sur une plaque à plus de 250°c. la réaction de
        maillard forme une croûte caramélisée en quelques secondes.
      </p>
      <p>
        la croûte enferme les sucs, la viande reste juteuse. cuisson minute, chaque burger
        monté à la commande.
      </p>
    </div>
  </section>

  <section class="bg-[var(--color-ink)] text-[var(--color-bg)]">
    <div class="mx-auto max-w-6xl px-5 md:px-8 py-20 md:py-28 grid md:grid-cols-2 gap-12 md:gap-16">
      <div>
        <h2 class="lc page-title">les produits.</h2>
      </div>
      <div class="prose-body lc space-y-5 text-white/90">
        <p>
          <span class="font-bold">le boeuf</span> est livré frais chaque matin, haché du jour.
          boucher du pays basque.
        </p>
        <p>
          <span class="font-bold">le pain brioché</span> vient d'un boulanger local. toasté au
          beurre avant le dressage.
        </p>
        <p>
          <span class="font-bold">les pickles, le coleslaw et les sauces</span> sont préparés sur
          place.
        </p>
        <p>
          <span class="font-bold">les frites</span> sont taillées chaque matin, cuites deux fois
          à la graisse de boeuf. friteuse végétale sur demande.
        </p>
        <p>
          <span class="font-bold">les boissons</span> : kombucha basque (datxa), citronnade et
          thé glacé maison, bière collab avec landberry.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 md:px-8 py-20 md:py-28 grid md:grid-cols-12 gap-10 md:gap-16 items-center">
    <div class="md:col-span-5 order-2 md:order-1 prose-body lc space-y-5">
      <p class="lead">trois burgers, deux sides, six boissons.</p>
      <p>
        ouvert 7j/7, midi et soir, en service continu de 12h à 22h. commandes au comptoir
        uniquement.
      </p>
      <p>
        une dizaine de minutes entre la commande et le sachet. cb ou espèces.
      </p>
    </div>
    <div class="md:col-span-7 order-1 md:order-2">
      <Picture
        src={counterPlancha}
        alt="comptoir inox et plancha, service en cours chez nelly's burger biarritz"
        formats={['avif', 'webp']}
        widths={[480, 768, 1024, 1400]}
        sizes="(min-width: 768px) 58vw, 100vw"
        loading="lazy"
        class="w-full aspect-[4/3] object-cover rounded-[var(--radius-lg)]"
      />
    </div>
  </section>

  <section class="border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-6xl px-5 md:px-8 py-20 md:py-28 grid md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-7">
        <Picture
          src={ceilingNeons}
          alt="plafond brut et néons industriels, décor minimal de nelly's burger biarritz"
          formats={['avif', 'webp']}
          widths={[480, 768, 1024, 1400]}
          sizes="(min-width: 768px) 58vw, 100vw"
          loading="lazy"
          class="w-full aspect-[4/3] object-cover rounded-[var(--radius-lg)]"
        />
      </div>
      <div class="md:col-span-5 prose-body lc space-y-5">
        <p class="lc meta">le lieu</p>
        <h2 class="lc section-title mb-2">décor minimal, lumière directe.</h2>
        <p>
          béton brut, néons, faïence blanche. cuisine ouverte, comptoir inox. la salle est petite,
          on ne s'y assoit pas.
        </p>
        <p>en été, comptez quinze minutes d'attente.</p>
      </div>
    </div>
  </section>

</Layout>
