---
/*
  / — Dashboard d'accueil pour présentation client.
  Deux sections hiérarchisées :
    1. Versions (catégorie A) — directions abouties, mises en avant
    2. Previews (catégorie B) — explorations one-pager v3, filtrables par courant
  AUCUNE version n'est en production : tout est démo.
*/

type Version = {
  id: string;
  href: string;
  direction: string;
  type: 'Site complet' | 'Homepage seule';
  status: string;
  tagline: string;
  kind: 'editorial' | 'pixel' | 'cybersigil' | 'y2k-dark' | 'y2k-light' | 'editorial-press' | 'paul-bohne';
};

const versions: Version[] = [
  { id: 'v8', href: '/v8',  kind: 'paul-bohne',      direction: 'Paul & Bohne × carreaux écrus', type: 'Homepage seule', status: 'aboutie', tagline: 'vidéo hero plein cadre, mur de carreaux écrus bistrot, Brandon Grotesque, header glass sticky, scroll & enjoy.' },
  { id: 'v7', href: '/v7',  kind: 'editorial-press', direction: 'Édition du soir',                type: 'Homepage seule', status: 'aboutie', tagline: 'broadsheet éditorial, masthead presse, centerfold annoté autour du burger 3D, ticker, sceau de cire.' },
  { id: 'v6', href: '/v6/', kind: 'y2k-light',       direction: 'Y2K lumineux',                   type: 'Site complet',   status: 'aboutie', tagline: 'burger 3D en lévitation + portail doré, palette crème, jaune Nelly\'s, halo doré, étoiles dorées.' },
  { id: 'v5', href: '/v5/', kind: 'y2k-dark',        direction: 'Y2K dark',                       type: 'Site complet',   status: 'aboutie', tagline: 'globe wireframe qui tourne, fond noir d\'espace, frutiger aero, étoiles scintillantes.' },
  { id: 'v4', href: '/v4/', kind: 'cybersigil',      direction: 'Cyber-sigilism',                 type: 'Site complet',   status: 'aboutie', tagline: 'noir & blanc strict, sparkles animés, micro-interaction souris, esprit underground.' },
  { id: 'v2', href: '/v2',  kind: 'pixel',           direction: 'Pixel synthwave',                type: 'Site complet',   status: 'aboutie', tagline: 'néon ambré, scanlines CRT, marquee photos, VT323 sur les titres.' },
  { id: 'v1', href: '/v1/', kind: 'editorial',       direction: 'SEO baseline',                   type: 'Site complet',   status: 'référence', tagline: 'design initial bilingue fr/en, json-ld restaurant, sitemap, hierarchie SEO complète. base de comparaison.' }
];

type Courant = 'acid' | 'brutalist' | 'cybersigil' | 'diner' | 'editorial' | 'pixel' | 'riso' | 'techno' | 'y2k';

type Preview = { id: string; title: string; courant: Courant; tag: string };

const previews: Preview[] = [
  { id: 'a',  title: 'diner ambré',                   courant: 'diner',      tag: 'Diner' },
  { id: 'a1', title: 'acid chrome blob',              courant: 'acid',       tag: 'Acid' },
  { id: 'a2', title: 'liquid chrome multi',           courant: 'acid',       tag: 'Acid' },
  { id: 'b',  title: 'jour / nuit',                   courant: 'editorial',  tag: 'Éditorial' },
  { id: 'b1', title: 'brutalist times',               courant: 'brutalist',  tag: 'Brutalist' },
  { id: 'b2', title: 'brutalist arial wallpaper',     courant: 'brutalist',  tag: 'Brutalist' },
  { id: 'c',  title: 'éditorial chrome',              courant: 'editorial',  tag: 'Éditorial' },
  { id: 'c1', title: 'cyber sparkles comet',          courant: 'cybersigil', tag: 'Cyber-sigil' },
  { id: 'c2', title: 'cyber tribal sigil',            courant: 'cybersigil', tag: 'Cyber-sigil' },
  { id: 'd',  title: 'pixel diurne',                  courant: 'pixel',      tag: 'Pixel' },
  { id: 'e',  title: 'neon menu board',               courant: 'diner',      tag: 'Diner' },
  { id: 'f',  title: 'sticker collage',               courant: 'riso',       tag: 'Riso' },
  { id: 'g',  title: 'magazine cover',                courant: 'editorial',  tag: 'Éditorial' },
  { id: 'h',  title: 'risograph poster',              courant: 'riso',       tag: 'Riso' },
  { id: 'i',  title: 'koppen calm (scandinave)',      courant: 'editorial',  tag: 'Éditorial' },
  { id: 'j',  title: 'koppen index (taxonomie)',      courant: 'editorial',  tag: 'Éditorial' },
  { id: 'k',  title: 'koppen sequence (storyboard)',  courant: 'editorial',  tag: 'Éditorial' },
  { id: 'l',  title: 'dash stamp (badge jaune)',      courant: 'diner',      tag: 'Diner' },
  { id: 'm',  title: 'dash mosaic',                   courant: 'diner',      tag: 'Diner' },
  { id: 'n',  title: 'dash diner card',               courant: 'diner',      tag: 'Diner' },
  { id: 'o',  title: 'koppen v2 (serif éditorial)',   courant: 'editorial',  tag: 'Éditorial' },
  { id: 'p',  title: 'dash v2 (chunky + marquees)',   courant: 'diner',      tag: 'Diner' },
  { id: 'q',  title: 'manifeste mono',                courant: 'editorial',  tag: 'Éditorial' },
  { id: 'r',  title: 'split asymétrique',             courant: 'editorial',  tag: 'Éditorial' },
  { id: 't1', title: 'techno grid horizon',           courant: 'techno',     tag: 'Techno' },
  { id: 't2', title: 'techno wireframe burger',       courant: 'techno',     tag: 'Techno' },
  { id: 'y1', title: 'y2k wireframe globe',           courant: 'y2k',        tag: 'Y2K' },
  { id: 'y2', title: 'y2k aqua OS',                   courant: 'y2k',        tag: 'Y2K' }
];

// chips de filtre — liste resserrée du brief client
const chips: { key: 'all' | Courant; label: string }[] = [
  { key: 'all',        label: 'Tous' },
  { key: 'acid',       label: 'Acid' },
  { key: 'y2k',        label: 'Y2K' },
  { key: 'techno',     label: 'Techno' },
  { key: 'cybersigil', label: 'Cyber-sigil' },
  { key: 'brutalist',  label: 'Brutalist' }
];

const updated = '2026-05-22';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nelly's — directions artistiques (présentation client)</title>
  <meta name="description" content="Tableau de bord de présentation client. Sept directions abouties et une galerie de 28 explorations stylistiques pour Nelly's, smash burger Biarritz." />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mulish:wght@300;400;500;700&display=swap" />
  <style>
    /* ====== reset ====== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:        #f6f2e8;
      --bg-deep:   #ebe5d5;
      --ink:       #0a0a08;
      --ink-soft:  #2a2820;
      --ink-muted: #5a5852;
      --ink-faint: #908d83;
      --line:      rgba(10, 10, 8, 0.12);
      --line-strong: rgba(10, 10, 8, 0.28);
      --yellow:    #f5d442;
      --yellow-deep:#d9b81c;
      --shadow:
        0 1px 0 rgba(255, 255, 255, 0.6) inset,
        0 1px 2px rgba(58, 50, 32, 0.06),
        0 12px 28px -12px rgba(58, 50, 32, 0.14),
        0 24px 48px -24px rgba(58, 50, 32, 0.08);
      --shadow-hover:
        0 1px 0 rgba(255, 255, 255, 0.7) inset,
        0 2px 4px rgba(58, 50, 32, 0.08),
        0 18px 36px -14px rgba(58, 50, 32, 0.18),
        0 32px 64px -28px rgba(58, 50, 32, 0.12);
      --ease:     cubic-bezier(0.65, 0, 0.35, 1);
      --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
      --sans: 'Brandon Grotesque', 'Mulish', -apple-system, BlinkMacSystemFont, ui-sans-serif, system-ui, sans-serif;
    }
    html, body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-weight: 400;
      font-size: 16px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    a { color: inherit; text-decoration: none; }
    :focus-visible { outline: 2px solid var(--yellow-deep); outline-offset: 3px; }

    /* ====== header ====== */
    header.top {
      position: sticky; top: 0; z-index: 50;
      background: rgba(246, 242, 232, 0.85);
      backdrop-filter: blur(14px) saturate(160%);
      -webkit-backdrop-filter: blur(14px) saturate(160%);
      border-bottom: 1px solid var(--line);
      padding: 1.2rem 5vw;
      display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    }
    .brand { display: flex; align-items: center; gap: 1rem; }
    .brand-mark {
      width: 92px; height: 30px;
      background-color: var(--ink);
      -webkit-mask-image: url('/media/nelly_s.svg');
              mask-image: url('/media/nelly_s.svg');
      -webkit-mask-size: contain; mask-size: contain;
      -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
      -webkit-mask-position: left center; mask-position: left center;
    }
    .brand-tag {
      font-family: var(--sans);
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-muted);
      padding-left: 1rem;
      border-left: 1px solid var(--line);
    }
    .top-right {
      font-family: var(--sans);
      font-weight: 500;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }
    @media (max-width: 640px) {
      .top-right { display: none; }
    }

    /* ====== intro ====== */
    section.intro {
      padding: clamp(4rem, 8vw, 7rem) 5vw clamp(3rem, 5vw, 4rem);
      max-width: 1280px;
      margin: 0 auto;
    }
    .kicker {
      font-family: var(--sans);
      font-weight: 500;
      font-size: 12px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--ink-muted);
      margin-bottom: 1.4rem;
    }
    .intro h1 {
      font-family: var(--sans);
      font-weight: 300;
      font-size: clamp(2.4rem, 5.5vw, 4.2rem);
      line-height: 1.05;
      letter-spacing: -0.025em;
      color: var(--ink);
      max-width: 22ch;
    }
    .intro h1 em {
      font-style: normal;
      color: var(--yellow-deep);
    }
    .intro p.lead {
      margin-top: 1.6rem;
      max-width: 56ch;
      font-family: var(--sans);
      font-weight: 300;
      font-size: clamp(1.05rem, 1.3vw, 1.18rem);
      line-height: 1.7;
      color: var(--ink-soft);
    }
    .intro-meta {
      margin-top: 2rem;
      display: flex; gap: 1.2rem; flex-wrap: wrap;
      font-family: var(--sans);
      font-weight: 500;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }
    .intro-meta .pill {
      padding: 0.4rem 0.8rem;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
    }
    .intro-meta .pill strong { color: var(--ink); font-weight: 700; margin-right: 0.4em; }

    /* ====== section header ====== */
    section.block {
      padding: 0 5vw;
      max-width: 1280px;
      margin: 0 auto clamp(4rem, 7vw, 6rem);
    }
    .block-head {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 1rem; margin-bottom: 2.2rem; padding-bottom: 1rem;
      border-bottom: 1px solid var(--line-strong);
    }
    .block-head h2 {
      font-family: var(--sans);
      font-weight: 300;
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--ink);
    }
    .block-head .block-meta {
      font-family: var(--sans);
      font-weight: 500;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-muted);
      white-space: nowrap;
    }
    .block-intro {
      font-family: var(--sans);
      font-weight: 400;
      font-size: 0.98rem;
      line-height: 1.6;
      color: var(--ink-soft);
      max-width: 60ch;
      margin-bottom: 2rem;
    }

    /* ====== Section 1 : Versions (grandes cartes) ====== */
    .versions-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.2rem, 2.4vw, 1.8rem);
    }
    @media (min-width: 720px)  { .versions-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1100px) { .versions-grid { grid-template-columns: repeat(3, 1fr); } }

    .v-card {
      display: flex; flex-direction: column;
      background: #ffffff;
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
      transition: transform 320ms var(--ease), box-shadow 320ms var(--ease), border-color 320ms var(--ease);
      overflow: hidden;
      position: relative;
    }
    .v-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
      border-color: var(--line-strong);
    }
    .v-thumb {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .v-thumb-id {
      position: absolute;
      bottom: 0.8rem; left: 1rem;
      font-family: var(--sans);
      font-weight: 700;
      font-size: clamp(1.5rem, 3vw, 2rem);
      line-height: 1;
      letter-spacing: -0.02em;
      color: var(--ink);
      z-index: 5;
    }
    .v-thumb-status {
      position: absolute;
      top: 0.8rem; right: 1rem;
      font-family: var(--sans);
      font-weight: 700;
      font-size: 9.5px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink);
      padding: 0.3rem 0.55rem;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      z-index: 5;
    }
    .v-thumb-status.is-ref {
      background: var(--yellow);
      color: var(--ink);
    }

    /* — thumbnails par direction (CSS only) — */
    .v-thumb[data-kind="editorial"]      { background: linear-gradient(135deg, #fafaf7 0%, #efeadc 100%); }
    .v-thumb[data-kind="editorial"]::after {
      content: 'nelly\27s'; font-family: var(--sans); font-weight: 300;
      font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.04em; color: var(--ink);
    }
    .v-thumb[data-kind="pixel"]          { background: #0a0a0a; }
    .v-thumb[data-kind="pixel"]::after   {
      content: 'NELLY\27S'; font-family: 'VT323', 'JetBrains Mono', monospace;
      font-size: clamp(2.4rem, 5vw, 3.4rem); color: #ffb648; letter-spacing: 0.06em;
      text-shadow: 0 0 12px rgba(255, 182, 72, 0.65), 0 0 24px rgba(255, 182, 72, 0.35);
    }
    .v-thumb[data-kind="pixel"]::before  {
      content: ''; position: absolute; inset: 0;
      background: repeating-linear-gradient(180deg, transparent 0, transparent 3px, rgba(255, 182, 72, 0.06) 3px, rgba(255, 182, 72, 0.06) 4px);
    }
    .v-thumb[data-kind="cybersigil"]     { background: #fafafa; position: relative; }
    .v-thumb[data-kind="cybersigil"]::after {
      content: '+';
      font-family: var(--sans); font-weight: 300; font-size: clamp(4rem, 9vw, 6rem);
      color: var(--ink); line-height: 0.8;
    }
    .v-thumb[data-kind="cybersigil"]::before {
      content: ''; position: absolute; inset: 20%;
      background:
        radial-gradient(circle at 10% 20%, var(--ink) 1px, transparent 1px),
        radial-gradient(circle at 80% 80%, var(--ink) 1.5px, transparent 1.5px),
        radial-gradient(circle at 30% 90%, var(--ink) 1px, transparent 1px);
      background-size: 100% 100%;
    }
    .v-thumb[data-kind="y2k-dark"]       { background: radial-gradient(ellipse at 50% 40%, #1a2a4a 0%, #050814 65%); }
    .v-thumb[data-kind="y2k-dark"]::after {
      content: ''; width: 56%; aspect-ratio: 1; border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.7);
      box-shadow: 0 0 22px rgba(108, 184, 255, 0.35);
      position: relative;
    }
    .v-thumb[data-kind="y2k-dark"]::before {
      content: ''; position: absolute; inset: 32%;
      border-top: 1px solid rgba(255, 255, 255, 0.5);
      border-bottom: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 50%;
      transform: scaleY(0.4);
    }
    .v-thumb[data-kind="y2k-light"]      { background: radial-gradient(ellipse at 50% 0%, #fff3b5 0%, #faf7f0 60%); }
    .v-thumb[data-kind="y2k-light"]::after {
      content: ''; width: 50%; aspect-ratio: 1; border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #f7b86a, #c87a2a 55%, #5c3812);
      box-shadow:
        inset 0 6px 14px rgba(255, 255, 255, 0.4),
        inset 0 -10px 20px rgba(60, 30, 5, 0.5),
        0 14px 28px -8px rgba(217, 168, 42, 0.55);
    }
    .v-thumb[data-kind="editorial-press"]{ background: #ece3cf; position: relative; }
    .v-thumb[data-kind="editorial-press"]::after {
      content: 'NELLY\27S'; font-family: 'Times New Roman', serif; font-style: italic;
      font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 800; color: #14161e;
      letter-spacing: -0.03em;
    }
    .v-thumb[data-kind="editorial-press"]::before {
      content: ''; position: absolute; left: 8%; right: 8%; top: 24%;
      height: 3px; border-top: 1px solid #14161e; border-bottom: 1px solid #14161e;
      box-sizing: content-box;
    }
    .v-thumb[data-kind="paul-bohne"]     {
      background-color: #e2dac8;
      background-image: url('/v8/assets/tiles.svg');
      background-size: 80% auto;
      background-repeat: repeat;
    }
    .v-thumb[data-kind="paul-bohne"]::after {
      content: ''; width: 38%; aspect-ratio: 1; border-radius: 50%;
      background: rgba(250, 247, 240, 0.95);
      box-shadow: 0 8px 24px -8px rgba(12, 12, 8, 0.4);
      position: relative;
      z-index: 2;
    }
    .v-thumb[data-kind="paul-bohne"]::before {
      content: ''; position: absolute; left: 50%; top: 50%;
      transform: translate(-40%, -50%);
      width: 0; height: 0;
      border-left: 14px solid #0a0a08;
      border-top: 9px solid transparent;
      border-bottom: 9px solid transparent;
      z-index: 3;
    }

    .v-body {
      padding: clamp(1.2rem, 2vw, 1.6rem);
      border-top: 1px solid var(--line);
      flex: 1;
      display: flex; flex-direction: column;
    }
    .v-type {
      font-family: var(--sans);
      font-weight: 500;
      font-size: 10.5px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-muted);
      margin-bottom: 0.7rem;
    }
    .v-direction {
      font-family: var(--sans);
      font-weight: 500;
      font-size: 1.25rem;
      line-height: 1.2;
      color: var(--ink);
      margin-bottom: 0.7rem;
      letter-spacing: -0.005em;
    }
    .v-tagline {
      font-family: var(--sans);
      font-weight: 400;
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--ink-soft);
      flex: 1;
      margin-bottom: 1.2rem;
    }
    .v-foot {
      display: flex; justify-content: space-between; align-items: center;
      font-family: var(--sans);
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .v-foot .arrow {
      transition: transform 240ms var(--ease);
      color: var(--ink-muted);
    }
    .v-card:hover .v-foot .arrow { transform: translateX(0.3em); color: var(--ink); }

    /* ====== Section 2 : Previews (mini-cartes filtrables) ====== */
    .chips {
      display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 2rem;
    }
    .chip {
      font-family: var(--sans);
      font-weight: 500;
      font-size: 11.5px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink-soft);
      padding: 0.45rem 0.95rem;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      background: transparent;
      cursor: pointer;
      transition: all 220ms var(--ease);
    }
    .chip:hover { color: var(--ink); border-color: var(--ink); }
    .chip.is-active {
      background: var(--ink);
      color: var(--bg);
      border-color: var(--ink);
    }

    .previews-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.8rem;
    }
    @media (min-width: 640px)  { .previews-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (min-width: 900px)  { .previews-grid { grid-template-columns: repeat(4, 1fr); } }
    @media (min-width: 1200px) { .previews-grid { grid-template-columns: repeat(5, 1fr); } }

    .p-card {
      display: flex; flex-direction: column;
      background: #ffffff;
      border: 1px solid var(--line);
      transition: transform 220ms var(--ease), box-shadow 220ms var(--ease), border-color 220ms var(--ease);
      overflow: hidden;
      position: relative;
    }
    .p-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow);
      border-color: var(--line-strong);
    }
    .p-card[data-hidden] { display: none; }

    .p-thumb {
      aspect-ratio: 4 / 3;
      position: relative;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
    }
    .p-id {
      position: absolute; bottom: 0.5rem; left: 0.7rem;
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: -0.01em;
      color: inherit;
      z-index: 5;
      text-transform: uppercase;
    }
    /* — thumbnails par courant (CSS only) — */
    .p-thumb[data-courant="acid"]      { background: linear-gradient(135deg, #cfd5e0 0%, #8a9bb8 50%, #d8def0 100%); color: #0a0a08; }
    .p-thumb[data-courant="acid"]::after {
      content: ''; width: 44%; aspect-ratio: 1; border-radius: 50%;
      background: linear-gradient(135deg, #ffffff 0%, #6f7d9c 60%, #1a2940 100%);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2), inset 0 4px 10px rgba(255, 255, 255, 0.5);
    }
    .p-thumb[data-courant="brutalist"] { background: #fafafa; color: #0a0a08; }
    .p-thumb[data-courant="brutalist"]::after {
      content: 'NELLY\27S'; font-family: 'Times New Roman', serif;
      font-weight: 700; font-size: 1.6rem; letter-spacing: -0.02em;
    }
    .p-thumb[data-courant="brutalist"]::before {
      content: ''; position: absolute; inset: 12% 12% auto 12%; height: 3px; background: #0a0a08;
    }
    .p-thumb[data-courant="cybersigil"]{ background: #fafafa; color: #0a0a08; }
    .p-thumb[data-courant="cybersigil"]::after {
      content: '★'; font-size: 2.8rem; line-height: 1; color: #0a0a08;
    }
    .p-thumb[data-courant="cybersigil"]::before {
      content: ''; position: absolute; inset: 0;
      background:
        radial-gradient(circle at 18% 24%, #0a0a08 1.2px, transparent 1.2px),
        radial-gradient(circle at 82% 76%, #0a0a08 1.5px, transparent 1.5px),
        radial-gradient(circle at 75% 22%, #0a0a08 1px, transparent 1px),
        radial-gradient(circle at 22% 78%, #0a0a08 1px, transparent 1px);
    }
    .p-thumb[data-courant="diner"]     { background: #14110a; color: #ffb648; }
    .p-thumb[data-courant="diner"]::after {
      content: 'OPEN'; font-family: var(--sans); font-weight: 700;
      font-size: 1.6rem; letter-spacing: 0.16em; color: #ffb648;
      text-shadow: 0 0 8px rgba(255, 182, 72, 0.65), 0 0 16px rgba(255, 182, 72, 0.4);
    }
    .p-thumb[data-courant="editorial"] { background: linear-gradient(135deg, #fafaf7 0%, #f0eadc 100%); color: #0a0a08; }
    .p-thumb[data-courant="editorial"]::after {
      content: 'nelly\27s'; font-family: 'Times New Roman', serif;
      font-style: italic; font-size: 1.8rem; font-weight: 400; letter-spacing: -0.02em;
    }
    .p-thumb[data-courant="pixel"]     { background: #1a1a1a; color: #fff; }
    .p-thumb[data-courant="pixel"]::after {
      content: ''; width: 60%; height: 60%;
      background:
        repeating-linear-gradient(0deg, transparent 0 5px, rgba(255, 255, 255, 0.1) 5px 6px),
        repeating-linear-gradient(90deg, #f5d442 0 8px, #d9b81c 8px 16px);
      border: 2px solid #0a0a08;
    }
    .p-thumb[data-courant="riso"]      { background: #f5e1c8; color: #c83b3b; }
    .p-thumb[data-courant="riso"]::after {
      content: 'RISO'; font-family: var(--sans); font-weight: 700;
      font-size: 1.7rem; letter-spacing: 0.06em; color: #c83b3b;
      mix-blend-mode: multiply;
    }
    .p-thumb[data-courant="riso"]::before {
      content: ''; position: absolute; right: 14%; top: 18%;
      width: 36%; aspect-ratio: 1; background: #f5d442; border-radius: 50%;
      mix-blend-mode: multiply; opacity: 0.7;
    }
    .p-thumb[data-courant="techno"]    { background: #0a0a0a; color: #5af278; }
    .p-thumb[data-courant="techno"]::before {
      content: ''; position: absolute; inset: 0;
      background:
        repeating-linear-gradient(0deg,  rgba(90, 242, 120, 0.12) 0 1px, transparent 1px 18px),
        repeating-linear-gradient(90deg, rgba(90, 242, 120, 0.12) 0 1px, transparent 1px 18px);
    }
    .p-thumb[data-courant="techno"]::after {
      content: '◢'; font-size: 2.4rem; line-height: 1; color: #5af278;
    }
    .p-thumb[data-courant="y2k"]       { background: radial-gradient(circle at 50% 30%, #b8e3f3 0%, #5b94be 100%); color: #fff; }
    .p-thumb[data-courant="y2k"]::after {
      content: ''; width: 56%; aspect-ratio: 1; border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.85);
      box-shadow: 0 0 18px rgba(255, 255, 255, 0.4) inset, 0 0 22px rgba(184, 227, 243, 0.5);
    }
    .p-thumb[data-courant="y2k"]::before {
      content: ''; position: absolute; inset: 34%;
      border: 1px solid rgba(255, 255, 255, 0.6);
      border-radius: 50%;
      transform: scaleY(0.35);
    }
    /* override pour que le code (.p-id) reste lisible sur fonds sombres */
    .p-thumb[data-courant="pixel"] .p-id,
    .p-thumb[data-courant="diner"] .p-id,
    .p-thumb[data-courant="techno"] .p-id,
    .p-thumb[data-courant="y2k"] .p-id { color: #fafafa; }

    .p-body {
      padding: 0.7rem 0.85rem 0.85rem;
      border-top: 1px solid var(--line);
    }
    .p-tag {
      font-family: var(--sans);
      font-weight: 500;
      font-size: 9.5px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-muted);
      margin-bottom: 0.3rem;
    }
    .p-title {
      font-family: var(--sans);
      font-weight: 400;
      font-size: 0.88rem;
      line-height: 1.3;
      color: var(--ink);
    }

    /* ====== Section 3 : à propos ====== */
    section.about {
      padding: 0 5vw clamp(4rem, 7vw, 6rem);
      max-width: 1280px;
      margin: 0 auto;
    }
    .about-card {
      background: #fff;
      border: 1px solid var(--line);
      padding: clamp(1.6rem, 3vw, 2.4rem);
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
    @media (min-width: 760px) {
      .about-card { grid-template-columns: 2fr 1fr; gap: 2.4rem; align-items: start; }
    }
    .about-card h3 {
      font-family: var(--sans);
      font-weight: 300;
      font-size: 1.4rem;
      line-height: 1.2;
      color: var(--ink);
      margin-bottom: 0.8rem;
    }
    .about-card p {
      font-family: var(--sans);
      font-weight: 400;
      font-size: 0.95rem;
      line-height: 1.65;
      color: var(--ink-soft);
    }
    .about-card p + p { margin-top: 0.8rem; }
    .about-meta {
      font-family: var(--sans);
      font-weight: 500;
      font-size: 10.5px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }
    .about-meta dl { display: grid; gap: 0.7rem; }
    .about-meta dt { color: var(--yellow-deep); margin-bottom: 0.2rem; font-weight: 700; }
    .about-meta dd { color: var(--ink-soft); font-weight: 400; }

    /* ====== footer ====== */
    footer.bottom {
      border-top: 1px solid var(--line);
      padding: 2.4rem 5vw;
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
      font-family: var(--sans);
      font-weight: 500;
      font-size: 10.5px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-muted);
      max-width: 1280px;
      margin: 0 auto;
    }
  </style>
</head>
<body>

<header class="top">
  <a class="brand" href="/" aria-label="Nelly's — dashboard">
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-tag">dashboard client</span>
  </a>
  <span class="top-right">smash burger biarritz · démos</span>
</header>

<!-- ====================  INTRO  ==================== -->
<section class="intro">
  <p class="kicker">Présentation client</p>
  <h1>Nelly's, sept directions <em>abouties</em> et vingt-huit explorations.</h1>
  <p class="lead">
    Tableau de bord de présentation des directions artistiques explorées pour Nelly's,
    smash burger à Biarritz. Aucune version n'est en production — toutes sont des démos
    cliquables. Les <strong>versions</strong> ci-dessous sont les directions abouties
    présentables au client. Les <strong>previews</strong> sont les explorations rapides
    qui ont permis de tester les courants avant d'aboutir en version complète.
  </p>
  <div class="intro-meta">
    <span class="pill"><strong>{versions.length}</strong> versions</span>
    <span class="pill"><strong>{previews.length}</strong> previews</span>
    <span class="pill"><strong>maj</strong> {updated}</span>
  </div>
</section>

<!-- ====================  SECTION 1 : VERSIONS  ==================== -->
<section class="block" id="versions">
  <div class="block-head">
    <h2>Versions abouties</h2>
    <span class="block-meta">{versions.length} directions · cliquables</span>
  </div>
  <p class="block-intro">
    Directions artistiques abouties, présentables au client. Sites complets multi-pages
    ou homepages seules selon l'avancement. Chaque carte ouvre la version dans une
    nouvelle vue ; retour ici via l'URL racine ou le logo.
  </p>

  <div class="versions-grid">
    {versions.map((v) => (
      <a class="v-card" href={v.href}>
        <div class="v-thumb" data-kind={v.kind}>
          <span class="v-thumb-id">{v.id}</span>
          {v.status === 'référence' ? (
            <span class="v-thumb-status is-ref">référence</span>
          ) : (
            <span class="v-thumb-status">{v.status}</span>
          )}
        </div>
        <div class="v-body">
          <p class="v-type">{v.type}</p>
          <h3 class="v-direction">{v.direction}</h3>
          <p class="v-tagline">{v.tagline}</p>
          <p class="v-foot">
            <span>{v.href}</span>
            <span class="arrow">→</span>
          </p>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- ====================  SECTION 2 : PREVIEWS  ==================== -->
<section class="block" id="previews">
  <div class="block-head">
    <h2>Previews — explorations stylistiques</h2>
    <span class="block-meta">{previews.length} one-pagers · v3</span>
  </div>
  <p class="block-intro">
    Explorations one-pager des directions artistiques avant aboutissement en version
    complète. Filtre par courant graphique pour resserrer la sélection. Le filtre
    « Tous » affiche les 28.
  </p>

  <div class="chips" role="tablist" aria-label="Filtrer par courant graphique">
    {chips.map((c, i) => (
      <button class={`chip${i === 0 ? ' is-active' : ''}`} data-chip={c.key} type="button">{c.label}</button>
    ))}
  </div>

  <div class="previews-grid">
    {previews.map((p) => (
      <a class="p-card" href={`/previews/${p.id}.html`} target="_blank" rel="noopener" data-courant={p.courant}>
        <div class="p-thumb" data-courant={p.courant}>
          <span class="p-id">{p.id}</span>
        </div>
        <div class="p-body">
          <p class="p-tag">{p.tag}</p>
          <p class="p-title">{p.title}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- ====================  SECTION 3 : ABOUT  ==================== -->
<section class="about">
  <div class="about-card">
    <div>
      <p class="kicker">à propos du projet</p>
      <h3>Pourquoi sept directions ?</h3>
      <p>
        Nelly's est un restaurant de smash burger à Biarritz (21 avenue du jardin public,
        ouvert depuis 2021). Le projet de site explore plusieurs identités visuelles
        pour trouver celle qui correspondra à la marque : éditoriale, vintage, néon,
        artisan ou minimaliste. Chaque version est traitée jusqu'à un état présentable
        (site complet ou homepage seule), avec son propre design system, sa propre typo,
        et ses propres animations.
      </p>
      <p>
        Les <strong>previews</strong> ont servi de tests rapides : 28 one-pagers
        couvrant les principaux courants graphiques contemporains (acid, y2k, techno,
        cyber-sigil, brutalist, et autres). Les directions retenues ont été développées
        en <strong>versions</strong> abouties.
      </p>
    </div>
    <div class="about-meta">
      <dl>
        <div><dt>statut</dt><dd>aucune version en prod, toutes démos</dd></div>
        <div><dt>dernière maj</dt><dd>{updated}</dd></div>
        <div><dt>stack</dt><dd>astro 5, html static, vercel</dd></div>
        <div><dt>doc</dt><dd><a href="/README.md">README</a> · <a href="https://github.com/jeantoulemonde/nellys-burger-website" rel="noopener">repo github</a></dd></div>
      </dl>
    </div>
  </div>
</section>

<footer class="bottom">
  <span>© 2026 Nelly's burger biarritz</span>
  <span>dashboard client · noindex</span>
</footer>

<script>
  // ====== filtre des previews ======
  (function () {
    const chips = document.querySelectorAll('.chip');
    const cards = document.querySelectorAll('.p-card');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        const key = chip.getAttribute('data-chip');
        cards.forEach((card) => {
          const courant = card.getAttribute('data-courant');
          if (key === 'all' || courant === key) {
            card.removeAttribute('data-hidden');
          } else {
            card.setAttribute('data-hidden', '');
          }
        });
      });
    });
  })();
</script>

</body>
</html>
