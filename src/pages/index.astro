---
import { Picture, getImage } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import InfoBlock from '~/components/InfoBlock.astro';
import MenuItem from '~/components/MenuItem.astro';
import { site } from '~/data/site';
import { menu } from '~/data/menu';

import menuLightbox from '~/assets/photos/menu-lightbox.jpg';
import kitchenWide from '~/assets/photos/kitchen-wide.jpg';
import counterPlancha from '~/assets/photos/counter-plancha.jpg';

const heroVideo = '/media/hero.mp4';
const heroVideoBytes = 6_399_320;

const dayMap: Record<string, string> = {
  Mo: 'Monday',
  Tu: 'Tuesday',
  We: 'Wednesday',
  Th: 'Thursday',
  Fr: 'Friday',
  Sa: 'Saturday',
  Su: 'Sunday',
};

const openingHoursSpecification = site.hours.map((slot) => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: slot.days.map((d) => dayMap[d]),
  opens: slot.opens,
  closes: slot.closes,
}));

const ogImage = await getImage({
  src: menuLightbox,
  width: 1200,
  height: 630,
  format: 'jpg',
  quality: 80,
});

const schemaImageMenu = await getImage({ src: menuLightbox, width: 1600, format: 'jpg', quality: 80 });
const schemaImageKitchen = await getImage({ src: kitchenWide, width: 1600, format: 'jpg', quality: 80 });
const schemaImageCounter = await getImage({ src: counterPlancha, width: 1600, format: 'jpg', quality: 80 });

// À remplacer à la mise en prod : remplacer site.url (https://example.com) par l'URL canonique
const abs = (p: string) => new URL(p, site.url).toString();

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${site.url}#restaurant`,
  name: site.name,
  url: site.url,
  logo: abs('/media/logo.png'),
  image: [abs(schemaImageMenu.src), abs(schemaImageKitchen.src), abs(schemaImageCounter.src)],
  description: site.description,
  servesCuisine: site.cuisine,
  priceRange: site.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    addressLocality: site.city,
    postalCode: site.postalCode,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  openingHoursSpecification,
  hasMenu: `${site.url}/menu`,
  sameAs: [site.instagram],
  acceptsReservations: 'False',
};

const previewItems = menu[0].items;
---

<Layout
  title={`smash burger à emporter à biarritz — ${site.name}`}
  description="smash burger à emporter à biarritz, 21 avenue du jardin public. cheeseburger, bacon, vg+, frites à la graisse de boeuf. 7j/7, midi et soir, commande au comptoir."
  path="/"
  image={ogImage.src}
  type="restaurant"
  jsonLd={restaurantSchema}
>
  <Hero
    video={heroVideo}
    videoBytes={heroVideoBytes}
    posterImage={menuLightbox}
    posterAlt="panneau menu lumineux nelly's burger à biarritz"
    eyebrow="smash burger · à emporter · biarritz"
    title="boeuf frais. pain brioché. american cheese."
    subtitle="trois burgers, des frites à la graisse de boeuf, c'est tout. ouvert 7j/7, midi et soir."
  />

  <section class="mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-24 grid gap-10 md:grid-cols-12 md:gap-16">
    <div class="md:col-span-5">
      <p class="lc meta mb-4">la maison</p>
      <h2 class="lc section-title">
        un smash burger, ce n'est pas un steak haché. c'est un geste.
      </h2>
    </div>
    <div class="md:col-span-7 prose-body lc space-y-4">
      <p>
        une boule de boeuf frais est écrasée sur la plancha à plus de 250°c. la croûte se forme en
        quelques secondes — caramélisation, sucs, jus. une tranche d'american cheese fond dessus.
        deux moitiés de pain brioché toasté au beurre. point.
      </p>
      <p>
        carte courte. produits frais. tout est préparé sur place, le jour même. pas de
        réservation, pas de téléphone, pas de livraison. on se sert au comptoir, on emporte, on
        mange chaud.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 md:px-8 grid md:grid-cols-3">
    <InfoBlock label="où" title={`${site.street}, ${site.city}`} href="/contact" cta="voir le plan">
      {site.street}<br />{site.postalCode} {site.city}
    </InfoBlock>
    <InfoBlock label="quand" title="7j/7 · 12h — 22h" href="/contact" cta="voir le détail">
      midi et soir, service continu<br />
      premier arrivé, premier servi
    </InfoBlock>
    <InfoBlock label="comment" title="à emporter uniquement" href="/menu" cta="voir le menu">
      commande au comptoir<br />
      cb et espèces
    </InfoBlock>
  </section>

  <section class="bg-[var(--color-ink)] text-[var(--color-bg)] mt-20">
    <div class="mx-auto max-w-6xl px-5 md:px-8 py-20 md:py-28 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="lc meta text-white/60 mb-3">le menu</p>
        <h2 class="lc page-title mb-6">
          trois burgers, deux sides, quelques boissons.
        </h2>
        <p class="lc prose-body text-white/85 max-w-md mb-8">
          on ne change pas la carte. on la fait bien. tous les ingrédients sont reçus frais et
          travaillés sur place.
        </p>
        <a
          href="/menu"
          class="lc inline-block text-sm font-bold border-b border-white pb-1 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors"
        >
          voir le menu complet
        </a>
      </div>

      <div class="bg-[var(--color-bg)] text-[var(--color-ink)] p-6 md:p-10">
        {previewItems.map((item) => <MenuItem {...item} />)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 md:px-8 py-20 md:py-28 grid md:grid-cols-2 gap-10 md:gap-16 items-center">
    <Picture
      src={kitchenWide}
      alt="cuisine de nelly's burger à biarritz : plancha, hotte inox, néons industriels"
      formats={['avif', 'webp']}
      widths={[480, 768, 1024]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading="lazy"
      class="w-full aspect-[4/5] object-cover rounded-[var(--radius-lg)]"
    />
    <div>
      <p class="lc meta mb-4">à biarritz</p>
      <h2 class="lc section-title mb-6">21 avenue du jardin public.</h2>
      <div class="prose-body lc space-y-4">
        <p>
          on est installés dans le quartier du jardin public, à quelques minutes à pied de la
          grande plage et des halles. cuisine ouverte, comptoir inox, plancha qui tourne midi et
          soir.
        </p>
        <p>
          on prend les commandes uniquement sur place. la préparation prend une dizaine de
          minutes. on emballe pour la plage, le parc, le bureau ou la maison.
        </p>
      </div>
      <a
        href="/le-concept"
        class="lc inline-block mt-6 text-sm font-bold border-b border-[var(--color-ink)] pb-1 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors"
      >
        notre concept
      </a>
    </div>
  </section>

  <section class="relative">
    <Picture
      src={counterPlancha}
      alt="comptoir inox et plancha en cuisine ouverte chez nelly's biarritz"
      formats={['avif', 'webp']}
      widths={[768, 1280, 1600]}
      sizes="100vw"
      loading="lazy"
      class="w-full h-[40vh] md:h-[55vh] object-cover"
    />
  </section>

  <section class="border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-20 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="lc meta mb-3">instagram</p>
        <h2 class="lc section-title">les nouveautés, les ruptures, les coulisses.</h2>
      </div>
      <div class="flex md:justify-end">
        <a
          href={site.instagram}
          rel="me noopener"
          target="_blank"
          class="lc inline-flex items-center gap-2 text-base font-bold border border-[var(--color-ink)] px-5 py-3 hover:bg-[var(--color-ink)] hover:text-[var(--color-bg)] transition-colors"
        >
          suivre {site.instagramHandle} sur instagram
        </a>
      </div>
    </div>
  </section>
</Layout>
