---
/*
  / — Dashboard d'accueil.
  Page neutre, non indexée. Liste les versions du site (v1 prod, v2/v4
  variantes) et la galerie des previews. N'utilise pas Layout car Header
  et Footer ciblent /v1/, ce qui n'a pas de sens sur cette page meta.
*/
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nelly's — dashboard</title>
  <meta name="description" content="Tableau de bord des versions du site Nelly's : v1 prod, variantes v2 et v4, galerie de previews." />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700,800&display=swap" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #fafaf7;
      --ink: #0a0a0a;
      --ink-muted: #5a5a57;
      --line: #e8e6df;
      --accent: #b23a2c;
      --ease: cubic-bezier(0.65, 0, 0.35, 1);
    }
    html, body { background: var(--bg); color: var(--ink); font-family: 'General Sans', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }

    header.top {
      padding: 3vh 5vw;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid var(--line);
    }
    .brand { display: flex; align-items: center; gap: 0.9rem; }
    .brand-mark {
      width: 88px; height: 32px;
      background-color: var(--ink);
      -webkit-mask-image: url('/media/nelly_s.svg'); mask-image: url('/media/nelly_s.svg');
      -webkit-mask-size: contain; mask-size: contain;
      -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
      -webkit-mask-position: center; mask-position: center;
    }
    .brand-tag {
      font-family: ui-monospace, monospace; font-size: 10px;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted);
    }
    .meta-top {
      font-family: ui-monospace, monospace; font-size: 11px;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
    }

    .intro { padding: 8vh 5vw 5vh; max-width: 1280px; margin: 0 auto; }
    .intro p.eyebrow {
      font-family: ui-monospace, monospace; font-size: 11px;
      letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink-muted);
      margin-bottom: 1rem;
    }
    .intro h1 {
      font-weight: 800; font-size: clamp(2.4rem, 6vw, 4.6rem);
      line-height: 1; letter-spacing: -0.035em;
      text-transform: lowercase; max-width: 16ch;
    }
    .intro p.lead {
      margin-top: 1.5rem; max-width: 60ch;
      font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.55; color: var(--ink-muted);
      text-transform: lowercase; font-weight: 500;
    }

    section.block { padding: 0 5vw; max-width: 1280px; margin: 0 auto 5vh; }
    section.block h2 {
      font-family: ui-monospace, monospace; font-size: 11px;
      letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink-muted);
      margin-bottom: 1.5rem; font-weight: 500;
    }
    .row { display: grid; gap: 1rem; grid-template-columns: 1fr; }
    @media (min-width: 640px) { .row { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1024px) {
      .row.cols-3 { grid-template-columns: repeat(3, 1fr); }
      .row.cols-4 { grid-template-columns: repeat(4, 1fr); }
    }

    .card {
      display: block; padding: 2rem 1.6rem;
      border: 1px solid var(--line); background: #fff;
      transition: border-color 200ms var(--ease), transform 200ms var(--ease);
    }
    .card:hover { border-color: var(--ink); }
    .card .tag {
      font-family: ui-monospace, monospace; font-size: 10px;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted);
      margin-bottom: 0.6rem;
    }
    .card .tag.live { color: var(--accent); }
    .card h3 {
      font-weight: 800; font-size: 1.4rem; line-height: 1.1;
      letter-spacing: -0.02em; text-transform: lowercase;
    }
    .card p {
      margin-top: 0.7rem; font-size: 0.95rem; line-height: 1.55;
      color: var(--ink-muted); text-transform: lowercase; font-weight: 500;
    }
    .card .arrow {
      margin-top: 1.2rem; font-family: ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    }
    .card:hover .arrow { color: var(--accent); }

    footer.bottom {
      padding: 4vh 5vw; border-top: 1px solid var(--line);
      font-family: ui-monospace, monospace; font-size: 11px;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    }
  </style>
</head>
<body>
  <header class="top">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-tag">dashboard</span>
    </a>
    <span class="meta-top">nelly's — smash burger biarritz</span>
  </header>

  <section class="intro">
    <p class="eyebrow">versions du site</p>
    <h1>tableau de bord nelly's.</h1>
    <p class="lead">
      point d'entrée des versions du site et des explorations design. la
      version de production est /v1/. /v2 et /v4 sont des variantes
      visuelles. /previews regroupe les explorations courtes.
    </p>
  </section>

  <section class="block">
    <h2>versions</h2>
    <div class="row cols-4">
      <a class="card" href="/v1/">
        <p class="tag live">version en prod</p>
        <h3>v1 · seo optimisé</h3>
        <p>site complet bilingue, json-ld restaurant, sitemap, page menu, contact, pages seo, version de production.</p>
        <p class="arrow">/v1/ →</p>
      </a>
      <a class="card" href="/v5/">
        <p class="tag">variante</p>
        <h3>v5 · y2k dark</h3>
        <p>site complet multi-pages, globe wireframe qui tourne, frutiger aero, fond noir d'espace, étoiles scintillantes. noindex.</p>
        <p class="arrow">/v5/ →</p>
      </a>
      <a class="card" href="/v4/">
        <p class="tag">variante</p>
        <h3>v4 · cyber-sigilism</h3>
        <p>site complet multi-pages, noir et blanc strict, sparkles animés, micro-interaction souris. noindex.</p>
        <p class="arrow">/v4/ →</p>
      </a>
      <a class="card" href="/v2">
        <p class="tag">variante</p>
        <h3>v2 · pixel synthwave</h3>
        <p>variante visuelle, copie identique, ambiance néon ambré, scanlines crt, vt323. noindex.</p>
        <p class="arrow">/v2 →</p>
      </a>
    </div>
  </section>

  <section class="block">
    <h2>explorations</h2>
    <div class="row cols-3">
      <a class="card" href="/v8">
        <p class="tag">home seule</p>
        <h3>v8 · paul & bohne x carreaux</h3>
        <p>home premium éditoriale, vidéo hero plein cadre, mur de carreaux écrus bistrot vintage en arrière-plan général, header sticky glass, scroll & enjoy.</p>
        <p class="arrow">/v8 →</p>
      </a>
      <a class="card" href="/v7">
        <p class="tag">home seule</p>
        <h3>v7 · édition du soir</h3>
        <p>home broadsheet éditorial, masthead presse, centerfold annoté autour du burger 3d (fig. 01), ticker stock-style, sceau de cire tournant. fraunces + newsreader.</p>
        <p class="arrow">/v7 →</p>
      </a>
      <a class="card" href="/v6/">
        <p class="tag">home seule</p>
        <h3>v6 · y2k lumineux</h3>
        <p>home exploratoire, burger 3d en lévitation + suivi souris, palette crème et jaune nelly's, halo doré, étoiles dorées. miroir clair de la v5 dark.</p>
        <p class="arrow">/v6/ →</p>
      </a>
    </div>
    <div class="row cols-3" style="margin-top: 1rem;">
      <a class="card" href="/previews/">
        <p class="tag">galerie</p>
        <h3>previews</h3>
        <p>une trentaine d'explorations courtes : pistes typographiques, expérimentations animation, variantes mises en page. point d'entrée unique.</p>
        <p class="arrow">/previews/ →</p>
      </a>
      <a class="card" href="https://www.instagram.com/nellysburgerz/" rel="me noopener" target="_blank">
        <p class="tag">externe</p>
        <h3>instagram @nellysburgerz</h3>
        <p>compte officiel, photos du comptoir, annonces ouverture, posts du jour.</p>
        <p class="arrow">instagram →</p>
      </a>
    </div>
  </section>

  <footer class="bottom">
    <span>© 2026 nelly's burger biarritz</span>
    <span>noindex · meta dashboard</span>
  </footer>
</body>
</html>
