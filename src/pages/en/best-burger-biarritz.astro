---
import { Picture } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import { restaurantSchema, breadcrumbSchema } from '~/data/schema';

import burgerPlate from '~/assets/photos/burger.jpg';
import storefrontQueue from '~/assets/photos/storefront-queue.jpg';

const jsonLd = [
  restaurantSchema,
  breadcrumbSchema([
    { name: 'Home', path: '/en' },
    { name: 'Best Burger Biarritz', path: '/en/best-burger-biarritz' },
  ]),
];
---

<Layout
  title="Best Burger Biarritz — Nelly's, smash burger takeaway"
  description="Looking for the best burger in Biarritz? Nelly's: three smash burgers, house fries, takeaway across from the public garden. Open every day."
  path="/en/best-burger-biarritz"
  image="/og-image.jpg"
  locale="en"
  alternates={{ fr: '/smash-burger-biarritz', en: '/en/best-burger-biarritz' }}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-5 md:px-8 pt-12 md:pt-20 pb-20">
    <p class="lc meta mb-3">best burger biarritz</p>
    <h1 class="lc page-title mb-6">the best burger in Biarritz.</h1>

    <Picture
      src={burgerPlate}
      alt="Best burger Biarritz, Nelly's cheeseburger on a plate, smash burger takeaway"
      formats={['avif', 'webp']}
      widths={[480, 768, 1024]}
      sizes="(min-width: 768px) 720px, 100vw"
      loading="eager"
      class="w-full aspect-[4/5] object-cover rounded-[var(--radius-lg)] mb-10"
    />

    <div class="prose-body lc space-y-5 text-[var(--color-ink)]">
      <p class="lead">
        We won't tell you we make the best burger in Biarritz. We'll tell
        you what we do, and you decide.
      </p>

      <h2 class="lc section-title mt-8 mb-3">what's actually in the burger</h2>
      <p>
        Fresh Basque beef, ground the morning of service. Two thin patties
        per burger, smashed on a 250°C flat top. American cheese that melts
        evenly. Brioche bun, butter-toasted. Pickles, onions, sauce. The
        cheeseburger goes for €9. The bacon for €10. The vg+ — falafel,
        eggplant — for €9.50.
      </p>

      <h2 class="lc section-title mt-10 mb-3">why short menus tend to win</h2>
      <p>
        A short menu means fewer ingredients to manage, more attention per
        burger, and zero stock that has been sitting since yesterday. Three
        burgers. Two sides. Six drinks. The full menu fits on one page.
      </p>

      <h2 class="lc section-title mt-10 mb-3">the takeaway angle</h2>
      <p>
        No dining room. No app. No reservations. Walk up to the counter,
        order, wait five to ten minutes, walk out with a kraft bag. The
        public garden is across the street if you want to sit down. The
        Grande Plage is ten minutes on foot.
      </p>

      <h2 class="lc section-title mt-10 mb-3">where to find us</h2>
      <p>
        21 avenue du jardin public, 64200 Biarritz. Yellow awning, neon
        sign reading <em>nelly's</em> in script. Open every day, 12pm to
        10pm. Card or cash.
      </p>

      <Picture
        src={storefrontQueue}
        alt="Best burger Biarritz Nelly's, queue at dusk in front of the storefront"
        formats={['avif', 'webp']}
        widths={[480, 768, 1024]}
        sizes="(min-width: 768px) 720px, 100vw"
        loading="lazy"
        class="w-full aspect-[4/5] object-cover rounded-[var(--radius-lg)] mt-10"
      />
    </div>

    <nav class="mt-12 pt-8 border-t border-[var(--color-line)] lc meta flex flex-col gap-2" aria-label="related pages">
      <a href="/en/smash-burger-biarritz" class="hover:text-[var(--color-ink)]">→ what is a smash burger?</a>
      <a href="/en/menu" class="hover:text-[var(--color-ink)]">→ see the menu and prices</a>
      <a href="/en/contact" class="hover:text-[var(--color-ink)]">→ contact and directions</a>
    </nav>
  </article>
</Layout>
