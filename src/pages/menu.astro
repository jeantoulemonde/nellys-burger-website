---
import Layout from '~/layouts/Layout.astro';
import MenuSectionComp from '~/components/MenuSection.astro';
import { site } from '~/data/site';
import { menu } from '~/data/menu';

const dayMap: Record<string, string> = {
  Mo: 'Monday',
  Tu: 'Tuesday',
  We: 'Wednesday',
  Th: 'Thursday',
  Fr: 'Friday',
  Sa: 'Saturday',
  Su: 'Sunday',
};

const openingHoursSpecification = site.hours.map((slot) => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: slot.days.map((d) => dayMap[d]),
  opens: slot.opens,
  closes: slot.closes,
}));

const menuSchema = {
  '@type': 'Menu',
  '@id': `${site.url}/menu#menu`,
  name: `menu de ${site.name}`,
  inLanguage: 'fr',
  hasMenuSection: menu.map((section) => ({
    '@type': 'MenuSection',
    name: section.title,
    hasMenuItem: section.items.map((item) => ({
      '@type': 'MenuItem',
      name: item.name,
      description: item.description,
      offers: {
        '@type': 'Offer',
        price: item.price.toFixed(2),
        priceCurrency: 'EUR',
      },
      ...(item.name === 'vg+'
        ? { suitableForDiet: 'https://schema.org/VegetarianDiet' }
        : {}),
    })),
  })),
};

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${site.url}#restaurant`,
  name: site.name,
  url: site.url,
  servesCuisine: 'Burger',
  priceRange: '€',
  acceptsReservations: false,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    addressLocality: site.city,
    postalCode: site.postalCode,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  openingHoursSpecification,
  sameAs: [site.instagram],
  hasMenu: menuSchema,
};

// compteurs pour la mini-nav
const counts = Object.fromEntries(menu.map((s) => [s.id, s.items.length]));
---

<Layout
  title="menu, smash burger à emporter à biarritz"
  description="le menu de nelly's burger à biarritz, à emporter. pour le menu, c'est simple."
  path="/menu"
  jsonLd={restaurantSchema}
>
  <article class="menu-page">
    <header class="menu-header">
      <p class="lc meta menu-eyebrow">le menu</p>
      <h1 class="menu-h1">pour le menu, c'est simple.</h1>
      <p class="menu-lead">à emporter | cb ou espèces</p>

      <nav class="menu-mini-nav" aria-label="sections du menu">
        {
          menu.map((s, i) => (
            <>
              {i > 0 && (
                <span class="menu-mini-sep" aria-hidden="true">·</span>
              )}
              <a href={`#${s.id}`} class="menu-mini-link">
                <span class="menu-mini-label">{s.title}</span>
                <span class="menu-mini-count">{counts[s.id]}</span>
              </a>
            </>
          ))
        }
      </nav>
    </header>

    <div class="menu-body" itemscope itemtype="https://schema.org/Menu">
      <meta itemprop="name" content={`menu de ${site.name}`} />
      {menu.map((section) => <MenuSectionComp section={section} />)}
    </div>

    <footer class="menu-footnotes-compact">
      <p class="lc">à emporter | cb ou espèces | pas de réservation</p>
    </footer>
  </article>
</Layout>

<style>
  .menu-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }
  @media (min-width: 768px) {
    .menu-page {
      padding: 4rem 2rem 5rem;
    }
  }

  .menu-header {
    margin-bottom: 2.5rem;
  }

  .menu-eyebrow {
    margin-bottom: 0.875rem;
  }

  .menu-h1 {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18ch;
    text-wrap: balance;
    text-transform: lowercase;
    margin: 0;
  }

  .menu-lead {
    margin-top: 1rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-text-soft);
    max-width: 48ch;
    text-transform: lowercase;
  }

  /* === mini-nav avec compteurs === */
  .menu-mini-nav {
    margin-top: 1.5rem;
    padding: 0.625rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    text-transform: lowercase;
  }

  .menu-mini-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--color-muted);
    font-weight: 500;
    transition: color 180ms ease;
    text-decoration: none;
  }
  .menu-mini-link:hover,
  .menu-mini-link:focus-visible {
    color: var(--color-ink);
  }

  .menu-mini-label {
    color: inherit;
  }

  .menu-mini-count {
    font-size: 0.75rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
    opacity: 0.75;
  }
  .menu-mini-link:hover .menu-mini-count,
  .menu-mini-link:focus-visible .menu-mini-count {
    opacity: 1;
  }

  .menu-mini-sep {
    color: var(--color-muted);
    opacity: 0.6;
  }

  /* === body / sections === */
  .menu-body {
    margin-top: 2.5rem;
  }

  /* === footnotes compactes (à emporter | cb | pas de réservation) === */
  .menu-footnotes-compact {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.85rem;
    color: var(--color-text-soft);
  }
</style>
