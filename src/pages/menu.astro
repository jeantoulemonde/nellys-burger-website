---
import Layout from '~/layouts/Layout.astro';
import MenuSectionComp from '~/components/MenuSection.astro';
import { site } from '~/data/site';
import { menu } from '~/data/menu';

const menuSchema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `menu de ${site.name}`,
  inLanguage: 'fr',
  hasMenuSection: menu.map((section) => ({
    '@type': 'MenuSection',
    name: section.title,
    hasMenuItem: section.items.map((item) => ({
      '@type': 'MenuItem',
      name: item.name,
      description: item.description,
      offers: {
        '@type': 'Offer',
        price: item.price.toFixed(2),
        priceCurrency: 'EUR',
      },
      ...(item.tag === 'végétarien'
        ? { suitableForDiet: 'https://schema.org/VegetarianDiet' }
        : {}),
    })),
  })),
};
---

<Layout
  title="menu, smash burger à emporter à biarritz"
  description="le menu complet de nelly's burger à biarritz : cheeseburger classique 9€, bacon 10€, vg+ 9,5€, frites graisse de boeuf 4€, boissons. à emporter."
  path="/menu"
  jsonLd={menuSchema}
>
  <section class="mx-auto max-w-3xl px-5 md:px-8 pt-16 md:pt-24 pb-8">
    <p class="lc meta mb-4">le menu</p>
    <h1 class="lc page-title mb-6">trois burgers, deux sides, quelques boissons.</h1>
    <p class="lc lead max-w-xl">
      la carte ne bouge pas. tous les prix sont en euros. carte bleue et espèces acceptées. à
      emporter uniquement.
    </p>
  </section>

  <div
    class="mx-auto max-w-3xl px-5 md:px-8 pb-24"
    itemscope
    itemtype="https://schema.org/Menu"
  >
    <meta itemprop="name" content={`menu de ${site.name}`} />
    {menu.map((section) => <MenuSectionComp section={section} />)}
  </div>

  <section class="border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-3xl px-5 md:px-8 py-12 lc">
      <p class="meta mb-2">à savoir</p>
      <ul class="prose-body space-y-2 text-[0.95rem]">
        <li>· viande hachée du jour, jamais congelée.</li>
        <li>· pain brioché toasté au beurre, fournisseur local.</li>
        <li>· pickles, sauces et coleslaw préparés sur place.</li>
        <li>· frites cuites à la graisse de boeuf, friteuse végétale dédiée sur demande.</li>
        <li>· pas de réservation. pas de téléphone. pas de livraison via plateforme.</li>
        <li>· allergènes : liste détaillée disponible au comptoir.</li>
      </ul>
    </div>
  </section>
</Layout>
