---
import { Picture } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import { site } from '~/data/site';
import { restaurantSchema, breadcrumbSchema } from '~/data/schema';

import storefront from '~/assets/photos/storefront.jpg';
import storefrontQueue from '~/assets/photos/storefront-queue.jpg';

const jsonLd = [
  restaurantSchema,
  breadcrumbSchema([
    { name: 'Accueil', path: '/' },
    { name: 'Biarritz', path: '/biarritz/jardin-public' },
    { name: 'Jardin public', path: '/biarritz/jardin-public' },
  ]),
];

const mapsEmbed = `https://www.google.com/maps?q=${encodeURIComponent(site.fullAddress)}&z=16&output=embed`;
---

<Layout
  title="Burger jardin public Biarritz — Nelly's"
  description="Smash burger Nelly's au jardin public, Biarritz. 21 avenue du jardin public, store jaune, enseigne néon. À dix minutes de la Grande Plage."
  path="/biarritz/jardin-public"
  image="/og-image.jpg"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-5 md:px-8 pt-12 md:pt-20 pb-20">
    <p class="lc meta mb-3">le quartier</p>
    <h1 class="lc page-title mb-6">au jardin public, Biarritz.</h1>

    <Picture
      src={storefrontQueue}
      alt="Nelly's burger Biarritz, file devant la vitrine au crépuscule, enseigne néon allumée avenue du jardin public"
      formats={['avif', 'webp']}
      widths={[480, 768, 1024]}
      sizes="(min-width: 768px) 720px, 100vw"
      loading="eager"
      class="w-full aspect-[4/5] object-cover rounded-[var(--radius-lg)] mb-10"
    />

    <div class="prose-body lc space-y-5 text-[var(--color-ink)]">
      <p class="lead">
        Nelly's est au 21 avenue du jardin public, à Biarritz. Repère :
        le store jaune et l'enseigne néon Nelly's, allumée le soir.
      </p>

      <p>
        Le quartier du jardin public est calme, à mi-chemin entre les Halles
        de Biarritz et le centre. Le jardin lui-même est à trente secondes,
        en face. C'est l'endroit où s'asseoir avec le sac kraft. Bancs,
        ombre, espace. La Grande Plage est à dix minutes à pied, en
        descendant. Le Casino municipal et le Phare de Biarritz à quinze.
      </p>

      <h2 class="lc section-title mt-10 mb-3">comment venir</h2>
      <p>
        À pied depuis la Grande Plage : remontez l'avenue de la Marne puis
        l'avenue du Jardin public. Dix minutes. À pied depuis la gare :
        environ vingt minutes par le centre. En bus : lignes desservant la
        Grande Plage (Chronoplus T1, lignes 4 et 13). À vélo : pistes le
        long de l'avenue. En voiture : zone payante, parkings publics à
        cinq minutes (Sainte-Eugénie, Halles). En haute saison, le
        stationnement direct est rare — venez à pied.
      </p>

      <h2 class="lc section-title mt-10 mb-3">l'adresse complète</h2>
      <address class="not-italic">
        Nelly's<br />
        21 avenue du jardin public<br />
        64200 Biarritz, France
      </address>

      <div class="w-full aspect-[16/10] mt-6 rounded-[var(--radius-lg)] overflow-hidden border border-[var(--color-line)]">
        <iframe
          title="Plan d'accès Nelly's burger Biarritz, 21 avenue du jardin public"
          src={mapsEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full border-0"
        ></iframe>
      </div>

      <Picture
        src={storefront}
        alt="vitrine Nelly's burger Biarritz, store jaune sur l'avenue du jardin public"
        formats={['avif', 'webp']}
        widths={[480, 768, 1024]}
        sizes="(min-width: 768px) 720px, 100vw"
        loading="lazy"
        class="w-full aspect-[4/5] object-cover rounded-[var(--radius-lg)] mt-10"
      />
    </div>

    <nav class="mt-12 pt-8 border-t border-[var(--color-line)] lc meta flex flex-col gap-2" aria-label="pages liées">
      <a href="/smash-burger-biarritz" class="hover:text-[var(--color-ink)]">→ smash burger Biarritz, expliqué</a>
      <a href="/burger-a-emporter-biarritz" class="hover:text-[var(--color-ink)]">→ burger à emporter Biarritz, comment ça marche</a>
      <a href="/contact" class="hover:text-[var(--color-ink)]">→ contact et horaires</a>
    </nav>
  </article>
</Layout>
